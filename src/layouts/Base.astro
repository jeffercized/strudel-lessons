---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
// Strudel is AGPL-3.0: anyone using the site must be able to get its source.
const REPO = 'https://github.com/jeffercized/strudel-lessons';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <main class="page"><slot /></main>
    <footer class="site-footer">
      Built with <a href="https://strudel.cc">Strudel</a> (<a href={`${REPO}/blob/main/LICENSE`}>AGPL-3.0</a>) · <a href={REPO}>Source code</a>
    </footer>
  </body>
</html>
